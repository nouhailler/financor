# Laisser vide pour désactiver un provider
FINNHUB_KEY=
TWELVE_KEY=
FMP_KEY=
AV_KEY=

# Comportement du router
AUTO_FAILOVER=true
MAX_RETRIES=2
TIMEOUT=5.0
