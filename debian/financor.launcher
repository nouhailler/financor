#!/bin/bash
# financor — Lanceur Financor
# Le frontend est pré-buildé dans /usr/share/financor/frontend/dist/
# Ce script vérifie la config, exporte FINANCOR_STATIC_DIR et démarre uvicorn.

INSTALL_DIR="/usr/share/financor"
BACKEND_DIR="$INSTALL_DIR/backend"
FRONTEND_DIST="$INSTALL_DIR/frontend/dist"
ENV_FILE="$BACKEND_DIR/.env"

# ── Vérification .env ─────────────────────────────────────────────────────────
if [ ! -f "$ENV_FILE" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  Financor — Configuration requise (première utilisation)    ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                              ║"
    echo "║  Configurez au moins une clé API :                          ║"
    echo "║                                                              ║"
    echo "║    sudo cp /usr/share/financor/backend/.env.example  \\      ║"
    echo "║             /usr/share/financor/backend/.env                ║"
    echo "║    sudo nano /usr/share/financor/backend/.env               ║"
    echo "║                                                              ║"
    echo "║  Clés gratuites sur : https://finnhub.io/register           ║"
    echo "║  Puis relancez : financor                                   ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

# ── Vérification du dist (pré-buildé dans le .deb) ────────────────────────────
if [ ! -f "$FRONTEND_DIST/index.html" ]; then
    echo ""
    echo "  ✗ Erreur : le frontend pré-buildé est introuvable."
    echo "  Attendu : $FRONTEND_DIST/index.html"
    echo ""
    echo "  Tentative de réinstallation :"
    echo "    wget https://github.com/nouhailler/financor/releases/download/v1.0.0/financor_1.0.0_all.deb"
    echo "    sudo dpkg -i financor_1.0.0_all.deb"
    echo ""
    exit 2
fi

# ── Démarrage ─────────────────────────────────────────────────────────────────
export FINANCOR_STATIC_DIR="$FRONTEND_DIST"

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                  Financor v1.0.0                            ║"
echo "╠══════════════════════════════════════════════════════════════╣"
echo "║  Adresse  : http://localhost:8000                           ║"
echo "║  API docs : http://localhost:8000/docs                      ║"
echo "║  Arrêter  : Ctrl+C                                          ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

# Ouvrir le navigateur après 2 secondes
(sleep 2 && xdg-open http://localhost:8000 2>/dev/null || true) &

# Démarrer le serveur
cd "$BACKEND_DIR"
exec .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
