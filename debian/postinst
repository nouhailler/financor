#!/bin/bash
# postinst — Script post-installation Financor
set -e

INSTALL_DIR="/usr/share/financor"
BACKEND_DIR="$INSTALL_DIR/backend"
FRONTEND_DIR="$INSTALL_DIR/frontend"

echo ""
echo "  Configuration de Financor..."

# ── Venv Python ───────────────────────────────────────────────────────────────
if [ ! -d "$BACKEND_DIR/.venv" ]; then
    echo "  Création de l'environnement Python virtuel..."
    python3 -m venv "$BACKEND_DIR/.venv"
fi

echo "  Installation des dépendances Python..."
"$BACKEND_DIR/.venv/bin/pip" install --quiet --upgrade pip
"$BACKEND_DIR/.venv/bin/pip" install --quiet -r "$BACKEND_DIR/requirements.txt"

# ── Build frontend React (exécuté en root → accès en écriture sur /usr/share/) ──
# Nécessaire car les utilisateurs non-root ne peuvent pas écrire dans /usr/share/
if [ -f "$FRONTEND_DIR/package.json" ] && ! [ -d "$FRONTEND_DIR/dist" ]; then
    echo "  Construction du frontend React (peut prendre 30-60 s)..."
    cd "$FRONTEND_DIR"
    if npm install --silent 2>/dev/null && npm run build --silent 2>/dev/null; then
        echo "  Frontend construit avec succès."
        # Rendre le dist lisible par tous les utilisateurs
        chmod -R a+rX "$FRONTEND_DIR/dist"
    else
        echo "  ⚠ Construction du frontend échouée — sera retentée au premier lancement."
        echo "  ⚠ Vérifiez que Node.js >= 18 est installé : node --version"
    fi
fi

# ── Permissions ───────────────────────────────────────────────────────────────
chmod 755 "$BACKEND_DIR/start.sh" 2>/dev/null || true
# Permettre aux utilisateurs non-root de lire/exécuter le frontend
chmod -R a+rX "$FRONTEND_DIR" 2>/dev/null || true
# Permettre la création du dist si le build postinst a échoué
chmod a+w "$FRONTEND_DIR" 2>/dev/null || true

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║           Financor v1.0.0 installé avec succès !            ║"
echo "╠══════════════════════════════════════════════════════════════╣"
echo "║                                                              ║"
echo "║  1. Configurez vos clés API (au moins une) :                ║"
echo "║                                                              ║"
echo "║     sudo cp /usr/share/financor/backend/.env.example  \\     ║"
echo "║              /usr/share/financor/backend/.env               ║"
echo "║     sudo nano /usr/share/financor/backend/.env              ║"
echo "║                                                              ║"
echo "║  2. Lancez l'application :                                  ║"
echo "║     financor                                                 ║"
echo "║                                                              ║"
echo "║  Docs : https://github.com/nouhailler/financor              ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""
